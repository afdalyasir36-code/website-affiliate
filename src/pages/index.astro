---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="RekomendasiTekno - Review Gadget & Produk Terbaik">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-700 text-white rounded-2xl p-8 md:p-12 mb-12 shadow-xl shadow-primary-500/10">
    <div class="max-w-2xl">
      <span class="bg-primary-500/40 text-primary-100 text-xs font-semibold px-3 py-1 rounded-full border border-primary-400/30">Panduan Pembelian Jujur</span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mt-4 leading-tight">Cari Produk Terbaik Tanpa Bingung Memilih</h1>
      <p class="mt-4 text-primary-100 text-base md:text-lg leading-relaxed">Ulasan objektif, rekomendasi mendalam, dan perbandingan harga resmi untuk membantu Anda membuat keputusan yang tepat.</p>
    </div>
  </section>

  <!-- Article Grid Section -->
  <!-- Filter Kategori Tombol -->
<div class="flex flex-wrap gap-2 mb-8">
  <a href="/" class="bg-slate-900 text-white text-sm font-semibold px-4 py-2 rounded-xl">Semua Produk</a>
  <a href="/category/elektronik" class="bg-white border border-slate-200 text-slate-700 hover:border-amber-500 hover:text-amber-600 text-sm font-semibold px-4 py-2 rounded-xl transition">Elektronik</a>
  <a href="/category/beauty" class="bg-white border border-slate-200 text-slate-700 hover:border-amber-500 hover:text-amber-600 text-sm font-semibold px-4 py-2 rounded-xl transition">Kecantikan</a>
  <a href="/category/rumah-tangga" class="bg-white border border-slate-200 text-slate-700 hover:border-amber-500 hover:text-amber-600 text-sm font-semibold px-4 py-2 rounded-xl transition">Rumah Tangga</a>
</div>
  <section id="review">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-slate-900">Ulasan & Rekomendasi Terbaru</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
          {post.data.heroImage && (
            <img src={post.data.heroImage} alt={post.data.title} class="w-full h-48 object-cover" />
          )}
          <div class="p-5 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
              <a href={`/category/${post.data.category.toLowerCase()}`} class="bg-slate-100 hover:bg-amber-100 hover:text-amber-700 text-slate-700 text-xs font-medium px-2.5 py-0.5 rounded-full transition">
  {post.data.category}
</a>
                <span class="text-xs text-amber-500 font-bold">★ {post.data.rating}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 leading-snug hover:text-primary-600 transition">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <p class="text-slate-600 text-sm mt-2 line-clamp-2">{post.data.description}</p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <a href={`/blog/${post.slug}`} class="text-primary-600 font-semibold text-sm hover:underline">Baca Review →</a>
              <a href={post.data.affiliateLink} target="_blank" rel="sponsored nofollow" class="bg-amber-500 hover:bg-amber-600 text-slate-900 text-xs font-bold px-3 py-1.5 rounded-lg transition">
                Cek di {post.data.affiliatePlatform}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>