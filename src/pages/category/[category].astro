---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueCategories = [...new Set(allPosts.map((post) => post.data.category))];

  return uniqueCategories.map((category) => {
    const filteredPosts = allPosts.filter((post) => post.data.category === category);
    return {
      params: { category: category.toLowerCase() },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { category } = Astro.params;
const { posts, categoryName } = Astro.props;
---

<Layout title={`Kategori: ${categoryName} | CariBarang.id`}>
  <section class="mb-8">
    <div class="bg-white p-6 rounded-2xl border border-slate-200">
      <span class="text-xs font-semibold uppercase tracking-wider text-primary-600">Kategori Produk</span>
      <h1 class="text-3xl font-extrabold text-slate-900 mt-1 capitalize">{categoryName}</h1>
      <p class="text-slate-600 text-sm mt-1">Menampilkan {posts.length} ulasan produk pilihan dalam kategori ini.</p>
    </div>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => (
      <article class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
        {post.data.heroImage && (
          <img src={post.data.heroImage} alt={post.data.title} class="w-full h-48 object-cover" />
        )}
        <div class="p-5 flex-grow flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-slate-100 text-slate-700 text-xs font-medium px-2.5 py-0.5 rounded-full">{post.data.category}</span>
              <span class="text-xs text-amber-500 font-bold">★ {post.data.rating}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 leading-snug hover:text-primary-600 transition">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="text-slate-600 text-sm mt-2 line-clamp-2">{post.data.description}</p>
          </div>
          
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <a href={`/blog/${post.slug}`} class="text-primary-600 font-semibold text-sm hover:underline">Baca Review →</a>
            <a href={post.data.affiliateLink} target="_blank" rel="sponsored nofollow" class="bg-amber-500 hover:bg-amber-600 text-slate-900 text-xs font-bold px-3 py-1.5 rounded-lg transition">
              Cek di {post.data.affiliatePlatform}
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
</Layout>