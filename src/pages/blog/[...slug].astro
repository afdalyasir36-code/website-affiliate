---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | RekomendasiTekno`} description={post.data.description}>
  <article class="max-w-3xl mx-auto bg-white p-6 md:p-10 rounded-2xl border border-slate-200 shadow-sm">
    <!-- Meta Info -->
    <div class="mb-6">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-3">
        <span class="bg-primary-50 text-primary-700 font-medium px-3 py-1 rounded-full text-xs">{post.data.category}</span>
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-slate-900 leading-tight">{post.data.title}</h1>
      <p class="text-slate-600 text-base md:text-lg mt-3 leading-relaxed">{post.data.description}</p>
    </div>

    {post.data.heroImage && (
      <img src={post.data.heroImage} alt={post.data.title} class="w-full h-auto max-h-[400px] object-cover rounded-xl mb-8" />
    )}

    <!-- Affiliate Callout Box (Top) -->
    <div class="bg-slate-900 text-white p-6 rounded-xl mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-1 text-amber-400 text-sm font-bold mb-1">
          <span>Skor Rekomendasi:</span>
          <span class="text-base">{post.data.rating} / 5.0</span>
        </div>
        <p class="text-slate-300 text-xs">Harga dan stok dapat berubah sewaktu-waktu di platform resmi.</p>
      </div>
      <a href={post.data.affiliateLink} target="_blank" rel="sponsored nofollow" class="w-full md:w-auto text-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-3 rounded-lg shadow-md transition text-sm">
        Beli di {post.data.affiliatePlatform} Sekarang →
      </a>
    </div>

    <!-- Article Content -->
    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-4">
      <Content />
    </div>

    <!-- Affiliate Callout Box (Bottom) -->
    <div class="mt-12 p-6 bg-amber-50 border border-amber-200 rounded-xl text-center">
      <h3 class="text-lg font-bold text-amber-950">Tertarik Membeli Produk Ini?</h3>
      <p class="text-amber-800 text-sm mt-1 mb-4">Dapatkan penawaran harga terbaik dan promo gratis ongkir langsung di toko resmi.</p>
      <a href={post.data.affiliateLink} target="_blank" rel="sponsored nofollow" class="inline-block bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold px-8 py-3 rounded-xl shadow transition">
        Kunjungi Lapak Resmi ({post.data.affiliatePlatform})
      </a>
    </div>
  </article>
</Layout>